  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Extensions\ABI\ABI.Models\ABI.Models.csproj" />
    <ProjectReference Include="..\..\Extensions\Haiyu.ABI\Haiyu.ABI.csproj" />
    <ProjectReference Include="..\..\Extensions\Haiyu.RpcClient\Haiyu.RpcClient.csproj" />
    <ProjectReference Include="..\..\Extensions\Haiyu.Plugin\Haiyu.Plugin.csproj" />
    <ProjectReference Include="..\..\Extensions\Haiyu.ServiceHost\Haiyu.ServiceHost.csproj" />
    <ProjectReference Include="..\..\Extensions\Waves.Api\Waves.Api.csproj" />
    <ProjectReference Include="..\..\Haiyu.KuroClient\Haiyu.KuroClient.csproj" />
    <ProjectReference Include="..\..\Waves.Core\Waves.Core.csproj" />
    <ProjectReference Include="..\..\Waves.Settings\Waves.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\HpatchzResource\hpatchz.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
