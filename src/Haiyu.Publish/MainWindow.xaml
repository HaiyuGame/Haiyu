<ui:FluentWindow
    x:Class="Haiyu.Publish.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:Haiyu.Publish.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ui="https://blame/fluentwpf/2023/"
    Title="Haiyu &#x53D1;&#x5E03;&#x5DE5;&#x5177;"
    Width="920"
    Height="680"
    MinWidth="760"
    MinHeight="560"
    Background="Transparent"
    Style="{DynamicResource DefaultWindowStyle}"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="AppTextFillBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="ControlFillColor" Color="#202A3A" />
        <SolidColorBrush x:Key="ControlSecondFillColor" Color="#2A3950" />
        <SolidColorBrush x:Key="ControlParssedFillColor" Color="#172131" />
        <SolidColorBrush x:Key="ControlBorderBrushColor" Color="#40516B" />
        <SolidColorBrush x:Key="TextBoxFocuedBrush" Color="#172131" />
        <SolidColorBrush x:Key="ComboBoxSelectItemMouseOverBrush" Color="#30415B" />
        <SolidColorBrush x:Key="AcceptColor" Color="#60A5FA" />
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.AppImageBackground>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#101722" />
                    <GradientStop Offset="0.55" Color="#121C2A" />
                    <GradientStop Offset="1" Color="#17243A" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </ui:FluentWindow.AppImageBackground>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock
                FontSize="27"
                FontWeight="SemiBold"
                Text="Haiyu &#x53D1;&#x5E03;&#x5DE5;&#x5177;" />
            <TextBlock
                Margin="0,6,0,20"
                Foreground="#91A1B8"
                Text="&#x4E00;&#x952E;&#x53D1;&#x5E03;&#x4E3B;&#x7A0B;&#x5E8F;&#x5E76;&#x751F;&#x6210; EXE &#x5B89;&#x88C5;&#x5305;&#x3002;" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="&#x7248;&#x672C;&#x53F7;" />
            <ui:FluentTextBox Grid.Column="1" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Grid.Column="2"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                Text="&#x6784;&#x5EFA;&#x914D;&#x7F6E;" />
            <ui:FluentComboBox
                Grid.Column="3"
                IsReadOnly="True"
                SelectedValue="{Binding Configuration}"
                SelectedValuePath="Content">
                <ComboBoxItem Content="Release" />
                <ComboBoxItem Content="Debug" />
            </ui:FluentComboBox>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="&#x4ED3;&#x5E93;&#x76EE;&#x5F55;" />
            <ui:FluentTextBox
                Grid.Column="1"
                IsReadOnly="True"
                Text="{Binding RepositoryRoot}" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="&#x8F93;&#x51FA;&#x76EE;&#x5F55;" />
            <ui:FluentTextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
            <ui:FluentButton
                Grid.Column="2"
                Margin="10,0,0,0"
                Command="{Binding OpenOutputCommand}"
                Content="&#x6253;&#x5F00;&#x76EE;&#x5F55;" />
        </Grid>
        <Border
            Grid.Row="4"
            Background="#0B111B"
            BorderBrush="#33445E"
            BorderThickness="1"
            CornerRadius="8">
            <ui:FluentTextBox
                Margin="10"
                Background="Transparent"
                ClearButtonVisibility="Collapsed"
                FontFamily="Consolas"
                FontSize="13"
                Foreground="#E8E8E8"
                IsReadOnly="True"
                Text="{Binding Log, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto">
                <i:Interaction.Behaviors>
                    <b:AutoScrollTextBoxBehavior />
                </i:Interaction.Behaviors>
            </ui:FluentTextBox>
        </Border>
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" />
                <ProgressBar
                    Width="360"
                    Height="5"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Maximum="100"
                    Value="{Binding Progress}" />
            </StackPanel>
            <ui:FluentButton
                Grid.Column="1"
                MinWidth="150"
                Background="#2563EB"
                BorderBrush="#60A5FA"
                Command="{Binding BuildCommand}"
                Content="&#x751F;&#x6210; EXE &#x5B89;&#x88C5;&#x5305;"
                FontWeight="SemiBold" />
        </Grid>
    </Grid>
</ui:FluentWindow>
