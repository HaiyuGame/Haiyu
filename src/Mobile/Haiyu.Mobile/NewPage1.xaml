<?xml version="1.0" encoding="utf-8" ?>
<cui:Popup
    x:Class="Haiyu.Mobile.NewPage1"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cui="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 与 geet.html 内固定尺寸保持一致：320 x 500 -->
        <Grid
            WidthRequest="320"
            HeightRequest="500">
            <WebView
                x:Name="webView"
                WidthRequest="320"
                HeightRequest="500"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
        </Grid>
        <Button
            Grid.Row="1"
            HorizontalOptions="Center"
            Text="跳转" />
    </Grid>
</cui:Popup>
