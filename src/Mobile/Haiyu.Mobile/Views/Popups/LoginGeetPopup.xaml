<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Haiyu.Mobile.Views.Popups.LoginGeetPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cui="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Haiyu.Mobile.ViewModels.Popups"
    x:DataType="vm:LoginGeetViewModel"
    Background="Transparent"
    HorizontalOptions="Fill"
    InputTransparent="False"
    VerticalOptions="Fill">
    <Grid
        x:Name="Grid"
        HeightRequest="500"
        InputTransparent="False"
        WidthRequest="320">

        <WebView
            x:Name="webView"
            HeightRequest="500"
            HorizontalOptions="Fill"
            InputTransparent="False"
            VerticalOptions="Fill"
            WidthRequest="320">
            <WebView.Behaviors>
                <toolkit:EventToCommandBehavior
                    BindingContext="{Binding BindingContext, Source={x:Reference Grid}}"
                    Command="{Binding LoadedCommand}"
                    CommandParameter="{x:Reference webView}"
                    EventName="Loaded" />
            </WebView.Behaviors>
        </WebView>
    </Grid>
</ContentView>
