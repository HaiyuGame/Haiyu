<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Haiyu.Mobile.Views.Popups.AddKuroTokenPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Haiyu.Mobile.ViewModels.Popups"
    x:DataType="vm:AddKuroTokenViewModel"
    HeightRequest="250">
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Entry
            Grid.Row="0"
            Placeholder="Token"
            Text="{Binding Token, Mode=TwoWay}" />
        <Entry
            Grid.Row="1"
            Placeholder="设备ID"
            Text="{Binding Did, Mode=TwoWay}" />
        <Entry
            Grid.Row="2"
            Placeholder="库街区ID"
            Text="{Binding PlayerId, Mode=TwoWay}" />
        <Button
            Grid.Row="3"
            Command="{Binding LoginCommand}"
            Text="登录" />
    </Grid>
    <Border>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

    </Border>
</ContentView>
