<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:property="using:Haiyu.Controls.Propertys"
    CornerRadius="5"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <SelectorBar Margin="0,-15,0,0" SelectionChanged="SelectorBar_SelectionChanged">
            <SelectorBarItem
                IsSelected="True"
                Tag="Phone"
                Text="{x:Bind helper:LanguageService.GetString('Display_PhoneNo')}" />
            <SelectorBarItem
                Tag="Token"
                Text="{x:Bind helper:LanguageService.GetString('Display_AuthorizedCode')}"
                Visibility="Visible" />
        </SelectorBar>
        <Border Grid.Row="1" Visibility="{x:Bind ViewModel.PhoneVisibility, Mode=OneWay}">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBox PlaceholderText="{x:Bind helper:LanguageService.GetString('Display_PhoneNo')}" Text="{x:Bind ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="{x:Bind helper:LanguageService.GetString('Display_Code')}" Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Command="{x:Bind ViewModel.ShowGetGeetCommand}"
                        Content="{x:Bind helper:LanguageService.GetString('Display_Item4')}" />
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Visibility="{x:Bind ViewModel.TokenVisibility, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBox PlaceholderText="{x:Bind helper:LanguageService.GetString('Display_EnterToken')}" Text="{x:Bind ViewModel.Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    PlaceholderText="{x:Bind helper:LanguageService.GetString('Display_AccountUid')}"
                    Text="{x:Bind ViewModel.TokenId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    PlaceholderText="{x:Bind helper:LanguageService.GetString('Display_DeviceDid')}"
                    Text="{x:Bind ViewModel.TokenDid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.TipMessage, Mode=OneWay}" />
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.LoginCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Login')}"
                Style="{ThemeResource AccentButtonStyle}" />
            <Button
                Grid.Column="1"
                Margin="5,0,0,0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Off')}" />
        </Grid>
    </Grid>
</ContentDialog>
