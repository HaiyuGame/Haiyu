<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.CloseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="5"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock
            FontFamily="{ThemeResource DefaultFont}"
            FontSize="19"
            Text="{x:Bind helper:LanguageService.GetString('Display_ExitOrNot')}" />
        <TextBlock
            Grid.Row="1"
            Margin="0,5,0,0"
            Foreground="{ThemeResource SystemChromeGrayColor}"
            Text="{x:Bind helper:LanguageService.GetString('Display_AboutEnd')}" />
        <CheckBox
            x:Name="isClose"
            Grid.Row="2"
            Content="{x:Bind helper:LanguageService.GetString('Display_DonTAskMeAgain')}" />
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Click="Min_Win"
                Content="{x:Bind helper:LanguageService.GetString('Display_MinimizeToPallet')}" />
            <Button
                Grid.Column="1"
                Margin="5,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Click="Close_Win"
                Content="{x:Bind helper:LanguageService.GetString('Display_JustLeave')}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</ContentDialog>
