<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.WavesCloudUserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wrapper="using:Haiyu.Models.Wrapper"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    CornerRadius="5"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Grid
        Width="350"
        Height="300"
        Padding="5"
        RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="18" Text="{x:Bind helper:LanguageService.GetString('WavesCloud_ManagerHeader')}" />
        <ItemsView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CloudUsers, Mode=OneWay}">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="wrapper:CloudGameLoginDataWrapper">
                    <ItemContainer IsSelected="{x:Bind IsSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <Grid Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock HorizontalAlignment="Left" Text="{x:Bind Phone, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                FontSize="12"
                                Foreground="{ThemeResource SystemColorGrayTextBrush}"
                                Text="{x:Bind UserName, Mode=OneWay}" />
                            <Button
                                Grid.RowSpan="2"
                                HorizontalAlignment="Right"
                                Command="{x:Bind DeleteCommand}"
                                Style="{ThemeResource TransparentButtonStyle}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
        </ItemsView>
        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="100"
                Padding="12,8"
                Command="{x:Bind ViewModel.ApplyCloudUserCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Apply')}"
                CornerRadius="8"
                Style="{ThemeResource AccentButtonStyle}" />
            <Button
                MinWidth="100"
                Padding="12,8"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Complete')}"
                CornerRadius="8" />
        </StackPanel>
    </Grid>
</ContentDialog>
