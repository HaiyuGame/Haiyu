<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.WavesRecords.RenameRecordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:local="using:Haiyu.Pages.Dialogs.WavesRecords"
    CornerRadius="8">
    <Grid
        VerticalAlignment="Center"
        ColumnSpacing="5"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBox Grid.ColumnSpan="2" Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.SaveRecordCommand}"
            Content="{x:Bind helper:LanguageService.GetString('Display_SAVING')}" />
        <Button
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.CloseCommand}"
            Content="{x:Bind helper:LanguageService.GetString('Display_SDecline')}" />
    </Grid>
</ContentDialog>

