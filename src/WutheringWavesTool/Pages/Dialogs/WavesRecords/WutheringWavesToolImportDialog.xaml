<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.WavesRecords.WutheringWavesToolImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Haiyu.Pages.Dialogs.WavesRecords"
    Title="导入 WutheringWavesTool 记录"
    CornerRadius="8">
    <StackPanel Width="420" Spacing="16">
        <Border
            Padding="14,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8B7;" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="合并到当前档案" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.RecordName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RecordName, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Spacing="8">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Excel 记录文件（.xlsx）" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="选择 WutheringWavesTool 导出的 Excel 文件"
                    Command="{x:Bind ViewModel.SelectFileCommand}"
                    Content="选择文件" />
            </Grid>
            <Border
                Padding="12,10"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="6">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.FilePath, Mode=OneWay}" />
            </Border>
        </StackPanel>
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="记录重合度" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.OverlapLabel, Mode=OneWay}" />
                </Grid>
                <ProgressBar
                    AutomationProperties.Name="导入记录与当前档案的重合度"
                    IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind ViewModel.OverlapPercent, Mode=OneWay}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="文件记录" />
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="重复记录" />
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.DuplicateLabel, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="预计新增" />
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.AddedLabel, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Margin="0,3,0,0"
                VerticalAlignment="Top"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE946;" />
            <TextBlock
                Grid.Column="1"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="小提示：请在 WutheringWavesTool 中导出 Excel 抽卡记录，再选择 .xlsx 文件。记录将合并到上方档案，无需填写 PlayerId，源文件会保留。"
                TextWrapping="Wrap" />
        </Grid>
        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind local:MergeRecordDialog.ErrorVisibility(ViewModel.ErrorMessage), Mode=OneWay}" />
        <Grid
            Margin="0,4,0,0"
            HorizontalAlignment="Right"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="取消"
                IsEnabled="{x:Bind local:MergeRecordDialog.IsIdle(ViewModel.IsBusy), Mode=OneWay}" />
            <Button
                Grid.Column="1"
                MinWidth="112"
                Command="{x:Bind ViewModel.MergeCommand}"
                Content="确认合并"
                IsEnabled="{x:Bind local:MergeRecordDialog.IsIdle(ViewModel.IsBusy), Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</ContentDialog>


