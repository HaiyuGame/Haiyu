<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.WebViewCabManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wr="using:Haiyu.Models.Wrapper"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    CornerRadius="5"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid Width="420" Height="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Margin="0,0,0,8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontFamily="{ThemeResource DefaultFont}"
                    FontSize="16"
                    Text="{x:Bind helper:LanguageService.GetString('WebViewEnv_ManagerHeader')}" />
                <TextBlock Foreground="{ThemeResource SystemColorGrayTextBrush}">
                    <Run Text="当前版本" />
                    <Run Text=": " />
                    <Run Text="{x:Bind ViewModel.CurrentVersion, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{ThemeResource TransparentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind helper:LanguageService.GetString('Display_Refresh')}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE72C;" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.SelectCabFilesCommand}"
                    Style="{ThemeResource TransparentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind helper:LanguageService.GetString('WebViewEnv_ImportRT')}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE710;" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.CloseCommand}"
                    Style="{ThemeResource TransparentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind helper:LanguageService.GetString('Display_Close')}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Glyph="&#xE894;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Import progress  -->
        <ProgressBar
            Grid.Row="1"
            Margin="0,0,0,8"
            HorizontalAlignment="Stretch"
            Maximum="100"
            Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            Value="{x:Bind ViewModel.ZipArchiveProgress, Mode=OneWay}" />

        <!--  Runtime list  -->
        <Grid Grid.Row="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemColorGrayTextBrush}"
                Text="{x:Bind helper:LanguageService.GetString('WebViewEnv_Empty')}"
                Visibility="{x:Bind ViewModel.HasRuntimes, Mode=OneWay, Converter={StaticResource BoolToVisibilityReversalConverter}}" />

            <ItemsView
                IsItemInvokedEnabled="True"
                ItemsSource="{x:Bind ViewModel.Runtimes, Mode=OneWay}"
                SelectionMode="Single"
                Visibility="{x:Bind ViewModel.HasRuntimes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="wr:WebViewRuntimeWrapper">
                        <ItemContainer IsSelected="{x:Bind IsSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <Grid
                                Padding="12,15"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlSolidFillColorDefault}"
                                BorderThickness="1"
                                ColumnSpacing="8"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontFamily="{ThemeResource DefaultFont}"
                                        FontSize="14"
                                        Text="{x:Bind DisplayName}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemColorGrayTextBrush}"
                                        Text="{x:Bind RuntimePath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind RuntimePath}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind DeleteRuntimeCommand}"
                                    Style="{ThemeResource TransparentButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind helper:LanguageService.GetString('Display_Delete')}"
                                    Visibility="{x:Bind IsEvergreen, Mode=OneWay, Converter={StaticResource BoolToVisibilityReversalConverter}}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
                <ItemsView.Layout>
                    <StackLayout Orientation="Vertical" Spacing="5" />
                </ItemsView.Layout>
            </ItemsView>
        </Grid>

        <!--  Footer  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="100"
                Padding="12,8"
                Command="{x:Bind ViewModel.ApplySelectCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Apply')}"
                CornerRadius="8"
                Style="{ThemeResource AccentButtonStyle}" />
            <Button
                MinWidth="100"
                Padding="12,8"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_Complete')}"
                CornerRadius="8" />
        </StackPanel>
    </Grid>
</ContentDialog>
