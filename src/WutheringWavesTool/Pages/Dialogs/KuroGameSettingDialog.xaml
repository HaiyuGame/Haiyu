<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.KuroGameSettingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:ani="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    CornerRadius="5"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <StackPanel
        HorizontalAlignment="Stretch"
        Orientation="Vertical"
        Spacing="5">
        <StackPanel.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition />
            </TransitionCollection>
        </StackPanel.ChildrenTransitions>

        <TextBlock
            HorizontalAlignment="Center"
            FontFamily="{ThemeResource DefaultFont}"
            FontSize="18"
            Text="{x:Bind helper:LanguageService.GetString('Display_GameSettings')}" />
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,15,0,0"
            Padding="15,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="5">
            <NumberBox Header="{x:Bind helper:LanguageService.GetString('Display_UnlimitedSpeed')}" Value="{x:Bind ViewModel.DownloadSpeedLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Border>
        <Border
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,0,0"
            Padding="15,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="5">
            <ComboBox
                Header="{x:Bind helper:LanguageService.GetString('Display_StartupObject')}"
                ItemsSource="{x:Bind ViewModel.LuancheExeNames, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.LauncheExeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Border>
        <Grid
            Grid.Row="3"
            Padding="10,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="5"
            RowSpacing="5"
            Visibility="{x:Bind ViewModel.WavesSettingVisibility, Mode=OneWay}">
            <ani:Implicit.ShowAnimations>
                <ani:OpacityAnimation To="1" Duration="0:0:0.5" />
            </ani:Implicit.ShowAnimations>
            <ani:Implicit.HideAnimations>
                <ani:OpacityAnimation To="1" Duration="0:0:0.5" />
            </ani:Implicit.HideAnimations>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Directx11" />
            <Border
                Grid.Column="1"
                Width="30"
                MaxWidth="30"
                HorizontalAlignment="Right">
                <CheckBox
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Right"
                    IsChecked="{x:Bind ViewModel.Directx11Enable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
            <NavigationViewItemSeparator Grid.Row="1" Grid.ColumnSpan="2" />
            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Text="{x:Bind helper:LanguageService.GetString('Display_DisableDlss')}" />
            <Border
                Grid.Row="2"
                Grid.Column="1"
                Width="30"
                MaxWidth="30"
                HorizontalAlignment="Right">
                <CheckBox
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Right"
                    IsChecked="{x:Bind ViewModel.DlssEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
        </Grid>
        <Grid
            Grid.Row="4"
            Margin="0,0,0,0"
            Padding="15,15"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="5">
            <TextBox Header="{x:Bind helper:LanguageService.GetString('Display_OtherStartupParameters')}" Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Button
            Grid.Row="5"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Command="{x:Bind ViewModel.CloseCommand}"
            Content="{x:Bind helper:LanguageService.GetString('Display_SAVING')}" />
    </StackPanel>
</ContentDialog>
