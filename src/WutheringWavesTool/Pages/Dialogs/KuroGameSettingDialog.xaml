<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.KuroGameSettingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    CornerRadius="5"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <StackPanel Spacing="12">
        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
            <StackPanel
                Width="450"
                HorizontalAlignment="Stretch"
                Orientation="Vertical"
                Spacing="12">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{ThemeResource DefaultFont}"
                    FontSize="18"
                    Text="{x:Bind helper:LanguageService.GetString('Display_GameSettings')}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="5">
                        <NumberBox
                            HorizontalAlignment="Stretch"
                            Header="{x:Bind helper:LanguageService.GetString('Display_UnlimitedSpeed')}"
                            Value="{x:Bind ViewModel.DownloadSpeedLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="5">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="{x:Bind helper:LanguageService.GetString('Display_StartupObject')}"
                            ItemsSource="{x:Bind ViewModel.LuancheExeNames, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.DefaultLaunchEnabled, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.LauncheExeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </Grid>
                <Border Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="5">
                    <StackPanel Spacing="10">
                        <CheckBox Content="使用自定义启动程序（如 Mod 启动器）"
                                  IsChecked="{x:Bind ViewModel.UseCustomLauncher, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="启动程序（.exe）" MinHeight="44"
                                     AutomationProperties.Name="自定义启动程序完整路径"
                                     Text="{x:Bind ViewModel.CustomLauncherPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <i:EventTriggerBehavior EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{x:Bind ViewModel.ValidateCustomLauncherCommand}" />
                                    </i:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <Button Grid.Column="1" Content="选择文件" MinHeight="44"
                                    VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCustomLauncherCommand}" />
                        </Grid>
                        <TextBox Header="启动器附加参数（追加到游戏参数后）"
                                 Text="{x:Bind ViewModel.CustomLauncherArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.HasCustomLaunchError, Mode=OneWay}"
                                 Severity="Error" IsClosable="False"
                                 Message="{x:Bind ViewModel.CustomLaunchError, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="5"
                    Visibility="{x:Bind ViewModel.WavesSettingVisibility, Mode=OneWay}">
                    <ani:Implicit.ShowAnimations>
                        <ani:OpacityAnimation To="1" Duration="0:0:0.5" />
                    </ani:Implicit.ShowAnimations>
                    <ani:Implicit.HideAnimations>
                        <ani:OpacityAnimation To="1" Duration="0:0:0.5" />
                    </ani:Implicit.HideAnimations>
                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="Directx11"
                            IsChecked="{x:Bind ViewModel.Directx11Enable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind helper:LanguageService.GetString('Display_DisableDlss')}"
                            IsChecked="{x:Bind ViewModel.DlssEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind helper:LanguageService.GetString('GameSettings_QuickVerify')}"
                            IsChecked="{x:Bind ViewModel.FastVerify, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Bind helper:LanguageService.GetString('Display_CleanGameLogsOnStart')}"
                            IsChecked="{x:Bind ViewModel.CleanLogsOnStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
                <Border
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="5">
                    <TextBox
                        HorizontalAlignment="Stretch"
                        Header="{x:Bind helper:LanguageService.GetString('Display_OtherStartupParameters')}"
                        Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Button
            HorizontalAlignment="Center"
            Command="{x:Bind ViewModel.SaveSettingsCommand}"
            Content="{x:Bind helper:LanguageService.GetString('Display_SAVING')}" />
    </StackPanel>
</ContentDialog>
