<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.UpdateGameDialogV2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Haiyu.Charts.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:m="using:Haiyu.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Grid MinWidth="400" MinHeight="250">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold">
                    <Run Text="{x:Bind ViewModel.LocalVersion, Mode=OneWay}" />
                    <Run Text="&gt;" />
                    <Run Text="{x:Bind ViewModel.NewVersion, Mode=OneWay}" />
                </TextBlock>
                <Button
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadedCommand}"
                    Style="{ThemeResource TransparentButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
            <InfoBar
                Margin="0,12,0,0"
                AutomationProperties.AutomationId="UpdateGameDialogV2_PackageStateChanged"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NeedsPackageTypeConfirmation, Mode=OneWay}"
                Message="{x:Bind helper:LanguageService.GetStringByText('游戏侧资源量状态与启动器偏好不一致，可能在游戏内清理或补充过资源。本次任务可能需要重新下载部分资源，请重新确认全量或精简选择。')}"
                Severity="Warning"
                Title="{x:Bind helper:LanguageService.GetStringByText('请重新确认资源量')}" />
            <ComboBox
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="UpdateGameDialogV2_PackageType"
                Header="{x:Bind helper:LanguageService.GetStringByText('资源量')}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolReversalConvert}}"
                SelectedIndex="{x:Bind ViewModel.SelectedPackageIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.PackageVisibility, Mode=OneWay}">
                <ComboBoxItem Content="{x:Bind helper:LanguageService.GetStringByText('全量资源')}" />
                <ComboBoxItem Content="{x:Bind helper:LanguageService.GetStringByText('精简资源')}" />
            </ComboBox>
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind helper:LanguageService.GetStringByText('资源量不影响材质质量；大小为估算值。')}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.PackageVisibility, Mode=OneWay}" />
            <TextBlock Margin="0,30,0,0" FontSize="15">
                <Run Text="{x:Bind helper:LanguageService.GetString('Display_TargetVersionSize')}" />
                <Run Text="{x:Bind ViewModel.NewFileSize, Mode=OneWay}" />
                <Run Text="GB" />
            </TextBlock>
            <TextBlock Margin="0,10,0,0" FontSize="15">
                <Run Text="{x:Bind helper:LanguageService.GetString('Display_OldVersionTargetSize')}" />
                <Run Text="{x:Bind ViewModel.LocalFileSize, Mode=OneWay}" />
                <Run Text="GB" />
            </TextBlock>
            <TextBlock Margin="0,10,0,0" Style="{ThemeResource BodyTextBlockStyle}">
                <Run Text="{x:Bind helper:LanguageService.GetStringByText('预计下载：')}" />
                <Run Text="{x:Bind ViewModel.DownloadFileSize, Mode=OneWay}" />
                <Run Text="GiB" />
            </TextBlock>
            <TextBlock Margin="0,10,0,0" FontSize="15">
                <Run Text="{x:Bind helper:LanguageService.GetString('Display_ReserveDiskStorage')}" />
                <Run Text="{x:Bind ViewModel.PatcherFileSize, Mode=OneWay}" />
                <Run Text="GB" />
            </TextBlock>
            <TextBlock Margin="0,10,0,0" FontSize="15">
                <Run Text="{x:Bind helper:LanguageService.GetString('Display_DiskFreeSpaceSize')}" />
                <Run Text="{x:Bind ViewModel.FreeDiskSpace, Mode=OneWay}" />
                <Run Text="GB" />
            </TextBlock>
        </StackPanel>

        <charts:PieChart
            Grid.Column="1"
            Background="Transparent"
            Series="{x:Bind ViewModel.DiskPipePoint, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.SelectDiffPathCommand}"
            Content="{x:Bind ViewModel.DiffSavePath, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolReversalConvert}}"
            ToolTipService.ToolTip="{x:Bind helper:LanguageService.GetString('Display_DownloadLocation')}" />
        <Grid
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="{x:Bind helper:LanguageService.GetString('Display_SDecline')}" />
            <Button
                Grid.Column="1"
                Margin="5,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InvokeCommand}"
                Content="{x:Bind ViewModel.InvokeName, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.EnableContinue, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</ContentDialog>
