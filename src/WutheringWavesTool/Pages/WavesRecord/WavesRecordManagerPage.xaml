<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Haiyu.Pages.WavesRecord.WavesRecordManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Haiyu.Controls"
    xmlns:cui="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Haiyu.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:qrModel="using:Waves.Api.Models.QRLogin"
    xmlns:ui="using:Haiyu.Controls"
    xmlns:vmWrapper="using:Haiyu.ViewModel"
    xmlns:wrapper="using:Waves.Api.Models"
    xmlns:wui="using:CommunityToolkit.WinUI.Controls"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="100" MaxWidth="240" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ui:TitleBar
            x:Name="titleBar"
            Grid.ColumnSpan="3"
            IsExtendsContentIntoTitleBar="True"
            TitleHorizontalAlignment="Center"
            TitleMode="Tall"
            TitleVerticalAlignment="Center">
            <ui:TitleBar.Header>
                <MenuBar>
                    <MenuBarItem Title="导入">
                        <MenuFlyoutItem Text="Haiyu V2 抽卡记录" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="WutheringWavesTool 工具" />
                        <MenuFlyoutItem Text="WavesTool 工具" />
                    </MenuBarItem>
                    <MenuBarItem Title="新建">
                        <MenuFlyoutItem Text="根据云鸣潮新建" />
                        <MenuFlyoutItem Text="选择游戏核心新建" />
                    </MenuBarItem>
                    <MenuBarItem Title="导出与合并">
                        <MenuFlyoutItem Text="合并抽卡记录信息" />
                        <MenuFlyoutItem Text="备份本地所有抽卡信息" />
                    </MenuBarItem>
                </MenuBar>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        <Grid
            Grid.Row="1"
            Margin="10,5,0,5"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Text="本地档案" />
                <ListView>
                    <ListViewItem>
                        <Grid>
                            <TextBlock Text="怪的档案" />
                        </Grid>
                    </ListViewItem>
                </ListView>
            </StackPanel>
        </Grid>
        <cui:GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,5"
            CornerRadius="5" />
        <Grid
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,5,5,5"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="5" />
    </Grid>
</Page>
