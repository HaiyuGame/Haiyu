<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Haiyu.Pages.Toolkits.MonitorToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adb="using:ChromeCDPSharp.Common"
    xmlns:controls="using:Haiyu.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Haiyu.Pages.Toolkits"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Haiyu.ViewModel.ToolkitsViewModel"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.Resources>
            <Style x:Key="TokenPanelBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>
            <Style x:Key="TokenPanelGridStyle" TargetType="Grid">
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Grid.Resources>
        <StackPanel
            Padding="10,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="5">
            <StackPanel
                Margin="5,0"
                Padding="12,6"
                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                CornerRadius="5"
                Orientation="Horizontal"
                Spacing="12">

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="3">
                    <TextBlock Text="FPS" />
                    <TextBlock FontWeight="Bold" Text="{x:Bind ViewModel.FPS, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="3">
                    <TextBlock Text="Frame Time" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.FrameTime, Mode=OneWay}" />
                    <TextBlock Text="ms" />
                </StackPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="3">
                    <TextBlock Text="0.1% Low" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Low01PercentFPS, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="3">
                    <TextBlock Text="MAX Time" />
                    <TextBlock Text="{x:Bind ViewModel.MaxFrameTime, Mode=OneWay}" />
                    <TextBlock Text="ms" />
                </StackPanel>
            </StackPanel>
            <ItemsControl ItemsSource="{x:Bind ViewModel.CPUS, Mode=OneWay}" Visibility="Visible">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorDeviceItem">
                        <StackPanel
                            Margin="5,0,0,0"
                            Padding="5"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            CornerRadius="5"
                            Orientation="Horizontal"
                            Spacing="5">
                            <TextBlock>
                                <Run Text="{x:Bind IndexStr, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{x:Bind Load, Mode=OneWay}" />
                                <Run Text="%" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{x:Bind Tempate, Mode=OneWay}" />
                                <Run Text="℃" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{x:Bind Voltages, Mode=OneWay}" />
                                <Run Text="V" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{x:Bind Clock, Mode=OneWay}" />
                                <Run Text="MHz" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>

                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.GPUS, Mode=OneWay}"
                Visibility="Visible">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorDeviceItem">
                        <StackPanel
                            Margin="5,0,0,0"
                            Padding="5"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            CornerRadius="5"
                            Orientation="Horizontal"
                            Spacing="5">
                            <TextBlock>
                                <Run Text="{x:Bind IndexStr, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{x:Bind Load, Mode=OneWay}" />
                                <Run Text="%" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{x:Bind Tempate, Mode=OneWay}" />
                                <Run Text="℃" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{x:Bind Clock, Mode=OneWay}" />
                                <Run Text="MHz" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>

                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>
