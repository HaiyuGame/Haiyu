<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Haiyu.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="using:Haiyu"
    xmlns:controls="using:Haiyu.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:Haiyu.Plugin.Extensions"
    xmlns:gamer="using:Waves.Api.Models.Communitys"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:item="using:Haiyu.Models"
    xmlns:local="using:Haiyu.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:Haiyu.Models.Settings"
    xmlns:uModel="using:Haiyu.ViewModel"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"
    xmlns:wr="using:Haiyu.Models.Wrapper"
    xmlns:wui="using:Haiyu.Controls"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ProgressBar
            HorizontalAlignment="Stretch"
            Background="Transparent"
            IsIndeterminate="{x:Bind ViewModel.ProgressAction, Mode=OneWay}" />
        <ScrollView
            Grid.Row="1"
            Padding="25"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="True" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Grid Height="200">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.RowSpan="3"
                        Margin="15,0,0,0"
                        Padding="10"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentAAFillColorDisabledBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="4"
                        CornerRadius="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <controls:ImageEx
                            Width="45"
                            Height="45"
                            Margin="5"
                            Source="ms-appx:///Assets/GameIcons/global.ico" />

                        <controls:ImageEx
                            Grid.Column="1"
                            Width="45"
                            Height="45"
                            Margin="5"
                            Source="ms-appx:///Assets/GameIcons/pgr.ico" />
                        <controls:ImageEx
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Width="45"
                            Height="45"
                            Margin="5"
                            Source="ms-appx:///Assets/appLogo.png" />
                    </Grid>
                    <Border
                        Grid.RowSpan="3"
                        Grid.ColumnSpan="2"
                        Background="{ThemeResource CardGradient2Brush}"
                        Canvas.ZIndex="-1"
                        CornerRadius="5" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="15,20,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource DefaultFont}"
                        FontSize="25"
                        Text="Haiyu" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="15,0,15,0"
                        FontFamily="{ThemeResource DefaultFont}"
                        Text="{x:Bind helper:LanguageService.GetString('Display_MaintenanceLightweighting')}"
                        TextWrapping="WrapWholeWords" />
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="15,0,0,30"
                        Orientation="Horizontal">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/BlameTwo/Haiyu" />
                        <HyperlinkButton Content="{x:Bind helper:LanguageService.GetString('Display_MingchaoOfficialSite')}" NavigateUri="https://mc.kurogames.com/" />
                        <HyperlinkButton Content="{x:Bind helper:LanguageService.GetString('Display_OfficialSite')}" NavigateUri="https://pns.kurogames.com/" />
                        <HyperlinkButton Content="{x:Bind helper:LanguageService.GetString('Display_DownloadTheLatestVersion')}" NavigateUri="https://github.com/BlameTwo/Haiyu/releases/latest" />
                        <HyperlinkButton Content="{x:Bind helper:LanguageService.GetString('Display_JoinTheDeveloperSNest')}" NavigateUri="https://qm.qq.com/q/4raTeh9MWI" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    Margin="0,15,0,0"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="15"
                    Text="{x:Bind helper:LanguageService.GetString('Display_General')}" />
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{x:Bind helper:LanguageService.GetString('Display_LauncherTheme')}">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Themes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{x:Bind helper:LanguageService.GetString('Display_LaunchHome')}">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ComboBox ItemsSource="{x:Bind ViewModel.AppLauncheBths, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectAppLauncheBth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="settings:LauncheBthWrapper">
                                <TextBlock Text="{x:Bind Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{x:Bind helper:LanguageService.GetString('SelectLanguage')}">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF2B7;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ComboBox
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        ItemsSource="{x:Bind ViewModel.LanguageSelectViewModel.Languages, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.LanguageSelectViewModel.SelectLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Style="{x:Null}">
                    <ui:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind helper:LanguageService.GetString('Display_BackgroundType')}" />
                            <Button
                                Margin="10,0,0,0"
                                Padding="0"
                                Style="{ThemeResource TransparentButtonStyle}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Glyph="&#xE752;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <TextBlock TextAlignment="Center">
                                            <Run Text="{x:Bind helper:LanguageService.GetString('Display_Item')}" />
                                            <LineBreak />
                                            <Run Text="{x:Bind helper:LanguageService.GetString('Display_SelectingPicture')}" />
                                        </TextBlock>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </ui:SettingsCard.Header>
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B9;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:SettingsCard.Content>
                        <ComboBox ItemsSource="{x:Bind ViewModel.WallpaperTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectWallpaperName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="uModel:WallpaperType">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:SettingsCard.Content>
                </ui:SettingsCard>

                <ui:SettingsExpander Margin="0,5,0,0" Header="{x:Bind helper:LanguageService.GetString('Display_Screenshot')}">
                    <ToggleSwitch
                        x:Name="captureSwitch"
                        IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        OffContent=""
                        OnContent="" />
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="Segoe UI Emoji" Glyph="&#x1F5BC;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard
                            Header="{x:Bind helper:LanguageService.GetString('Display_ScreenshotShortcuts')}"
                            IsClickEnabled="False"
                            IsEnabled="{x:Bind captureSwitch.IsOn, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox
                                    Margin="0,0,5,0"
                                    ItemsSource="{x:Bind ViewModel.CaptureModifierKeys, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.CaptureModifierKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="ext:ModifierKey">
                                            <TextBlock Text="{x:Bind Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Text="+" />
                                <ComboBox
                                    Margin="5,0,0,0"
                                    ItemsSource="{x:Bind ViewModel.CaptureKeys, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.CaptureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="ext:Keys">
                                            <TextBlock Text="{x:Bind Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard
                            Command="{x:Bind ViewModel.OpenCaptureFolderCommand}"
                            Header="{x:Bind helper:LanguageService.GetString('Display_ScreenshotSaveFolder')}"
                            IsClickEnabled="True"
                            IsEnabled="{x:Bind captureSwitch.IsOn, Mode=TwoWay}" />
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{x:Bind helper:LanguageService.GetString('Display_CloseButton')}"
                    IsClickEnabled="False">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe UI Emoji" Glyph="&#x1F615;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:SettingsCard.Content>
                        <ComboBox SelectedIndex="{x:Bind ViewModel.SelectCloseIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="{x:Bind helper:LanguageService.GetString('Display_Tray')}" />
                            <ComboBoxItem Content="{x:Bind helper:LanguageService.GetString('Display_Quit')}" />
                        </ComboBox>
                    </ui:SettingsCard.Content>
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    Description="{x:Bind helper:LanguageService.GetString('Display_TrySolve')}"
                    Header="{x:Bind helper:LanguageService.GetString('Display_LaunchingGame')}">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF45E;" />
                    </ui:SettingsCard.HeaderIcon>
                    <Border Width="30" MaxWidth="30">
                        <CheckBox IsChecked="{x:Bind ViewModel.StartGameAllowCloseMain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" />
                    </Border>
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    Command="{x:Bind ViewModel.ShowGameEnhancedDialogCommand}"
                    Header="{x:Bind helper:LanguageService.GetString('Display_GameMonitor')}"
                    IsClickEnabled="True">
                    <ui:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Find" />
                    </ui:SettingsCard.HeaderIcon>
                </ui:SettingsCard>
                <ui:SettingsCard Margin="0,5,0,0" Header="{x:Bind helper:LanguageService.GetString('Settings_AutoSkipDelete')}">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xECC9;" />
                    </ui:SettingsCard.HeaderIcon>
                    <Border Width="30" MaxWidth="30">
                        <CheckBox IsChecked="{x:Bind ViewModel.AutoSkipVerifyDelete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" />
                    </Border>
                </ui:SettingsCard>
                <ui:SettingsExpander
                    Margin="0,5,0,0"
                    Header="{x:Bind helper:LanguageService.GetString('Settings_SkipVerifyGameFile')}"
                    ItemsSource="{x:Bind ViewModel.SkipVerifyFiles, Mode=OneWay}">
                    <ui:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="wr:SkipGameVerifyWrapper">
                            <ui:SettingsCard Header="{x:Bind FilePath, Mode=OneWay}">
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind SenDeleteCommand}"
                                    Style="{ThemeResource TransparentButtonStyle}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="16"
                                        Glyph="&#xE74D;" />
                                </Button>
                            </ui:SettingsCard>
                        </DataTemplate>
                    </ui:SettingsExpander.ItemTemplate>
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF61C;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Content>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBox Width="200" Text="{x:Bind ViewModel.InputSkipVerifyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Command="{x:Bind ViewModel.AddVerifyFileCommand}"
                                Style="{ThemeResource TransparentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind helper:LanguageService.GetString('Settings_SkipAddVerifyFile')}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="15"
                                    Glyph="&#xE710;" />
                            </Button>
                        </StackPanel>
                    </ui:SettingsExpander.Content>
                </ui:SettingsExpander>
                <TextBlock
                    Margin="0,15,0,0"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="15"
                    Text="{x:Bind helper:LanguageService.GetString('Display_AppUpdate')}" />
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    Header="{x:Bind helper:LanguageService.GetString('Display_GithubTriageAcceleration')}"
                    Visibility="{x:Bind ViewModel.CheckUpdateVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SettingsCard.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch
                                x:Name="githubCdnEnable"
                                IsOn="{x:Bind ViewModel.GithubCdnEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                OffContent="{x:Bind helper:LanguageService.GetString('Display_Inactive')}"
                                OnContent="{x:Bind helper:LanguageService.GetString('Display_ENTRYINTOFORCE')}" />
                            <TextBox
                                Width="400"
                                IsEnabled="{x:Bind githubCdnEnable.IsOn, Mode=OneWay}"
                                Text="{x:Bind ViewModel.GithubCdn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Command="{x:Bind ViewModel.SaveeGithubCdnCommand}"
                                Content="{x:Bind helper:LanguageService.GetString('Display_SAVING')}"
                                IsEnabled="{x:Bind githubCdnEnable.IsOn, Mode=OneWay}" />
                        </StackPanel>
                    </ui:SettingsCard.Content>
                </ui:SettingsCard>
                <ui:SettingsExpander
                    Margin="0,5,0,0"
                    Header="{x:Bind helper:LanguageService.GetString('Display_DomainPreconfiguration')}"
                    ItemsSource="{x:Bind ViewModel.GithubIpGroups, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CheckUpdateVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SettingsExpander.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch
                                x:Name="githubFrontEnable"
                                IsOn="{x:Bind ViewModel.GithubFrontingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                OffContent="{x:Bind helper:LanguageService.GetString('Display_Inactive')}"
                                OnContent="{x:Bind helper:LanguageService.GetString('Display_ENTRYINTOFORCE')}" />
                            <Button
                                Command="{x:Bind ViewModel.SaveGithubIpConfigCommand}"
                                Content="{x:Bind helper:LanguageService.GetString('Display_ValidationConfiguration')}"
                                IsEnabled="{x:Bind githubFrontEnable.IsOn, Mode=OneWay}" />
                        </StackPanel>
                    </ui:SettingsExpander.Content>
                    <ui:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="uModel:GithubIpDisplayGroup">
                            <ui:SettingsCard Header="{x:Bind Host, Mode=OneWay}">
                                <ui:SettingsCard.Content>
                                    <TextBox Width="500" Text="{x:Bind IpEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </ui:SettingsCard.Content>
                            </ui:SettingsCard>
                        </DataTemplate>
                    </ui:SettingsExpander.ItemTemplate>
                </ui:SettingsExpander>
                <ui:SettingsExpander
                    Margin="0,5,0,0"
                    Description="{x:Bind a:App.AppVersion}"
                    Header="{x:Bind helper:LanguageService.GetString('Display_Version')}"
                    Visibility="{x:Bind ViewModel.CheckUpdateVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="Segoe UI Emoji" Glyph="&#x1F5DD;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Content>
                        <Button Command="{x:Bind ViewModel.UpdateVersionCommand}" Content="{x:Bind helper:LanguageService.GetString('Display_Update')}" />
                    </ui:SettingsExpander.Content>

                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="{x:Bind helper:LanguageService.GetString('Display_UpdateFeeds')}">
                            <ui:SettingsCard.Content>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{x:Bind ViewModel.UpdateAppType, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectUpdateAppType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                </Grid>
                            </ui:SettingsCard.Content>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="Mirror Key">
                            <ui:SettingsCard.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="200" Text="{x:Bind ViewModel.MirrorKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Margin="5,0,0,0"
                                        Command="{x:Bind ViewModel.SetMirrorKeyCommand}"
                                        Content="{x:Bind helper:LanguageService.GetString('Display_OK')}" />
                                    <Button Margin="5,0,0,0" Click="Button_Click">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE897;" />
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard.Content>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    Description="{x:Bind a:App.AppVersion}"
                    Header="{x:Bind helper:LanguageService.GetString('Display_Version')}"
                    Visibility="{x:Bind ViewModel.CheckUpdateVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityReversalConverter}}">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe UI Emoji" Glyph="&#x1F5DD;" />
                    </ui:SettingsCard.HeaderIcon>
                </ui:SettingsCard>
                <TextBlock
                    Margin="0,5,0,0"
                    FontFamily="{StaticResource DefaultFont}"
                    FontSize="15"
                    Text="{x:Bind helper:LanguageService.GetString('Display_StorageOther')}" />
                <ui:SettingsCard
                    Command="{x:Bind ViewModel.DeleteWebCacheCommandCommand}"
                    Header="{x:Bind helper:LanguageService.GetString('Display_DeleteWebCache')}"
                    IsClickEnabled="True">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" />
                    </ui:SettingsCard.HeaderIcon>
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    Command="{x:Bind ViewModel.OpenConfigFolderCommand}"
                    Header="{x:Bind helper:LanguageService.GetString('Display_ConfigureFolders')}"
                    IsClickEnabled="True">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe UI Emoji" Glyph="&#x1F4DA;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:SettingsCard.ActionIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7AC;" />
                    </ui:SettingsCard.ActionIcon>
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    Header="{x:Bind helper:LanguageService.GetString('Display_RpcKey')}"
                    IsEnabled="True">
                    <ui:SettingsCard.Content>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <PasswordBox
                                Width="200"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="18"
                                Password="{x:Bind ViewModel.RpcToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PasswordChar="*"
                                PasswordRevealMode="Peek" />
                            <Button
                                Margin="4,0,0,0"
                                Command="{x:Bind ViewModel.SetRpcTokenCommand}"
                                Content="{x:Bind helper:LanguageService.GetString('Display_OK')}"
                                Style="{ThemeResource TransparentButtonStyle}" />
                        </StackPanel>
                    </ui:SettingsCard.Content>
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" />
                    </ui:SettingsCard.HeaderIcon>
                </ui:SettingsCard>
                <ui:SettingsCard
                    Margin="0,5,0,0"
                    Command="{x:Bind ViewModel.CreateLinkCommand}"
                    Header="{x:Bind helper:LanguageService.GetString('Display_CreateShortcut')}"
                    IsClickEnabled="True"
                    Visibility="Collapsed">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:SettingsCard.ActionIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF466;" />
                    </ui:SettingsCard.ActionIcon>
                </ui:SettingsCard>
                <ui:SettingsExpander Margin="0,5,0,0" Header="{x:Bind helper:LanguageService.GetString('Display_DiagnosticEnvironment')}">
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Description="{x:Bind helper:LanguageService.GetString('Display_IconCheck')}" Header="{x:Bind helper:LanguageService.GetString('Display_FontFile')}">
                            <ui:SettingsCard.Content>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA8C;" />
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB05;" />
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB56;" />
                                </StackPanel>
                            </ui:SettingsCard.Content>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Bind helper:LanguageService.GetString('Display_WebKernelVersion')}">
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.WebViewVersion, Mode=OneWay}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Description="更改后重启 Haiyu 生效；兼容版需单独安装" Header="WebView2 启动版本">
                            <ComboBox
                                MinWidth="280"
                                ItemsSource="{x:Bind ViewModel.WebViewRuntimeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.WebViewRuntimeItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="wr:WebViewRuntimeWrapper">
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="WindowsApp Sdk">
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.WindowsAppSdkVersion, Mode=OneWay}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Bind helper:LanguageService.GetString('Display_RunType')}">
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.RunType, Mode=OneWay}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Bind helper:LanguageService.GetString('Display_FrameworkVersion')}">
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.FrameworkType, Mode=OneWay}" />
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
